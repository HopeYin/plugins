  "failure": [],
  "actions": [
    { "id": "move-left", "bindings": ["ArrowLeft", "KeyA"], "effect": "Move one grid cell left." },
    { "id": "move-right", "bindings": ["ArrowRight", "KeyD"], "effect": "Move one grid cell right." },
    { "id": "move-up", "bindings": ["ArrowUp", "KeyW"], "effect": "Move one grid cell up." },
    { "id": "move-down", "bindings": ["ArrowDown", "KeyS"], "effect": "Move one grid cell down." },
